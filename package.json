{
  "name": "koimidi",
  "version": "0.6.1",
  "description": "koimidi — free piano trainer for MIDI keyboards in the browser: falling notes with finger numbers, wait-for-key mode, built-in sound. No sign-up, files never leave the browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MeRuslan/koimidi.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/make-fixtures.mjs tests/fixtures"
  },
  "dependencies": {
    "@fontsource-variable/piazzolla": "^5.3.0",
    "@fontsource/golos-text": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.2.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tonejs/midi": "^2.0.28",
    "fflate": "^0.8.2",
    "spessasynth_lib": "^4.3.14"
  },
  "devDependencies": {
    "happy-dom": "^21.0.0",
    "spessasynth_core": "^4.3.22",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "homepage": "https://meruslan.github.io/koimidi/"
}
